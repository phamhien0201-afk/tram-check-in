<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100%" height="100%">
  <defs>
    <radialGradient id="normGrad" cx="45%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#FFFDF5"/>
      <stop offset="70%" stop-color="#FEF3C7"/>
      <stop offset="100%" stop-color="#FDE68A"/>
    </radialGradient>
  </defs>

  <!-- Face Body -->
  <circle cx="50" cy="50" r="40" fill="url(#normGrad)" stroke="#F59E0B" stroke-width="2.5"/>

  <!-- Cheeks Blush -->
  <circle cx="28" cy="55" r="6" fill="#F472B6" opacity="0.5"/>
  <circle cx="72" cy="55" r="6" fill="#F472B6" opacity="0.5"/>

  <!-- Round Dot Eyes with Sparkle -->
  <circle cx="39" cy="46" r="4.2" fill="#543A3A"/>
  <circle cx="40.5" cy="44.5" r="1.5" fill="#FFFFFF"/>

  <circle cx="61" cy="46" r="4.2" fill="#543A3A"/>
  <circle cx="62.5" cy="44.5" r="1.5" fill="#FFFFFF"/>

  <!-- Neutral Calm Line Mouth -->
  <path d="M 44 56 L 56 56" fill="none" stroke="#543A3A" stroke-width="3" stroke-linecap="round"/>
</svg>