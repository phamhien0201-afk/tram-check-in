<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100%" height="100%">
  <defs>
    <radialGradient id="worryGrad" cx="45%" cy="35%" r="65%">
      <stop offset="0%" stop-color="#FFFDF0"/>
      <stop offset="70%" stop-color="#FEF08A"/>
      <stop offset="100%" stop-color="#FACC15"/>
    </radialGradient>
    <radialGradient id="dropGrad" cx="30%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#BAE6FD"/>
      <stop offset="60%" stop-color="#38BDF8"/>
      <stop offset="100%" stop-color="#0284C7"/>
    </radialGradient>
  </defs>

  <!-- Face Body -->
  <circle cx="50" cy="52" r="39" fill="url(#worryGrad)" stroke="#CA8A04" stroke-width="2.5"/>

  <!-- Cheeks Blush -->
  <ellipse cx="27" cy="57" rx="7" ry="4" fill="#FB923C" opacity="0.45"/>
  <ellipse cx="73" cy="57" rx="7" ry="4" fill="#FB923C" opacity="0.45"/>

  <!-- Worried Eyebrows -->
  <path d="M 33 37 Q 40 42 45 39" fill="none" stroke="#543A3A" stroke-width="2.6" stroke-linecap="round"/>
  <path d="M 67 37 Q 60 42 55 39" fill="none" stroke="#543A3A" stroke-width="2.6" stroke-linecap="round"/>

  <!-- Concerned Eyes -->
  <circle cx="39" cy="48" r="4.2" fill="#543A3A"/>
  <circle cx="40.5" cy="46.5" r="1.5" fill="#FFFFFF"/>

  <circle cx="61" cy="48" r="4.2" fill="#543A3A"/>
  <circle cx="62.5" cy="46.5" r="1.5" fill="#FFFFFF"/>

  <!-- Nervous Wobbly Mouth -->
  <path d="M 44 60 Q 47 57 50 60 Q 53 63 56 60" fill="none" stroke="#543A3A" stroke-width="2.8" stroke-linecap="round"/>

  <!-- Blue Sweat Drop on Temple -->
  <g transform="translate(71, 23) rotate(15) scale(0.65)">
    <path d="M 12 0 C 12 0, 0 16, 0 24 C 0 32, 6 36, 12 36 C 18 36, 24 32, 24 24 C 24 16, 12 0, 12 0 Z" fill="url(#dropGrad)"/>
    <ellipse cx="8" cy="22" rx="3" ry="5" fill="#FFFFFF" opacity="0.7" transform="rotate(-20, 8, 22)"/>
  </g>
</svg>